# 火山方舟 API Key（视频生成 + 视觉分析）
ARK_API_KEY=your_ark_api_key_here

# 视觉分析模型（可选，默认 doubao-seed-2-1-pro-260628，需在方舟控制台开通）
ANALYZE_MODEL=doubao-seed-2-1-pro-260628

# 可灵 Kling API Key（预留）
KLING_API_KEY=your_kling_api_key_here

# Vercel Blob 存储（在 Vercel 后台创建 Blob Store 并关联项目后自动注入）
BLOB_READ_WRITE_TOKEN=auto_injected_by_vercel
